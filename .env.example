# Copie para .env. Nenhum valor aqui é segredo real.
POSTGRES_USER=lucroradar
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=lucroradar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Dados sintéticos
SEED=42
REFERENCE_DATE=2026-06-30

# Copiloto: deixe vazio para o modo "Demonstração sem modelo generativo".
# A chave fica só no servidor da API; nunca é enviada ao navegador.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5
COPILOT_EFFORT=medium
COPILOT_TIMEOUT_SECONDS=45
COPILOT_REQUESTS_PER_MINUTE=6
COPILOT_DAILY_LIMIT=200

# Exposição pública: production desliga /docs e exige POSTGRES_PASSWORD própria.
APP_ENV=development
# true só quando a API recebe tráfego exclusivamente do proxy do web
TRUST_FORWARDED_FOR=false

# Link exibido em "Como foi construído"
REPOSITORY_URL=https://github.com/Rheverson/lucroradar-ai

# Web → API (lado servidor do Next.js)
API_URL=http://localhost:8000

# --- Hospedagem (ver docs/hosting.md) ---
# Alternativa às POSTGRES_*: string completa. Em produção exija TLS (sslmode=require).
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
POSTGRES_SSLMODE=prefer
# Segredo compartilhado web → API. Definido nos dois serviços, a API recusa chamadas
# diretas a /api/v1/* e aceita o IP do visitante informado pelo proxy do web.
PROXY_SHARED_SECRET=
# URL pública do web, usada nos metadados de compartilhamento
SITE_URL=http://localhost:3000
